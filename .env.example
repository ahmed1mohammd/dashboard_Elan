# ==============================================================================
# ÉLAN Fine Fragrances — Admin Dashboard Environment Example (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local to customize API routing.
# Vite requires all client-exposed environment variables to start with VITE_
# ==============================================================================

# VITE_API_URL: Base URL for all Admin & Staff REST API endpoints.
# Usage: Base endpoint used by Axios service (Elan_Dashboard/src/services/api.js).
# Status: Optional in local development (Defaults to 'http://localhost:5000/api').
#         Required in production / deployment.
# Source:
#   - Local development: http://localhost:5000/api
#   - Staging: https://staging-api.elanperfume.com/api
#   - Production: https://api.elanperfume.com/api
VITE_API_URL=http://localhost:5000/api
